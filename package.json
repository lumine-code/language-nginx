{
  "name": "language-nginx",
  "author": "lumine-code",
  "version": "1.0.0",
  "main": "lib/main",
  "description": "Nginx configuration language support.",
  "keywords": [
    "webserver",
    "proxy",
    "reverse-proxy",
    "http",
    "configuration"
  ],
  "repository": "https://github.com/lumine-code/language-nginx",
  "bugs": {
    "url": "https://github.com/lumine-code/language-nginx/issues"
  },
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "hyperlink.injection": {
      "versions": {
        "^1.0.0": "consumeHyperlinkInjection"
      }
    },
    "todo.injection": {
      "versions": {
        "^1.0.0": "consumeTodoInjection"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
